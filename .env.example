# Flask security key.
SECRET_KEY=replace_with_a_long_random_secret_key

# Encryption key for sensitive values such as phone numbers.
DATA_ENCRYPTION_KEY=replace_with_a_fernet_key

# PostgreSQL connection supplied by Render:
# postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql+psycopg://username:password@host:5432/diabetes_project

# Use true only when the website runs through HTTPS.
COOKIE_SECURE=true

# Create missing database tables when the application starts.
AUTO_CREATE_TABLES=true

# Keep WhatsApp in safe simulation mode until production credentials exist.
WHATSAPP_DRY_RUN=true

# WhatsApp values will be added later.
WHATSAPP_ACCESS_TOKEN=replace_later
WHATSAPP_PHONE_NUMBER_ID=replace_later
WHATSAPP_API_VERSION=replace_later
