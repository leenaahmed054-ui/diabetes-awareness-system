+"""Queue a general awareness reminder outside active Ramadan periods."""
+
+import os
+
+from app.extensions import db
+from app.models import Notification, User
+from app.services.ramadan_service import get_active_ramadan_period, normalize_target_date
+
+DAILY_TIP_PREFIX = "daily_tip_"
+TIPS = (
+    "تذكير اليوم: دوّن سؤالًا تود طرحه في موعدك الصحي القادم.",
+    "تذكير اليوم: راجع دليل استخدام جهاز القياس قبل استعماله.",
+    "تذكير اليوم: راجع سجل تقييماتك في المنصة وجهّز أي استفسار للموعد القادم.",
+)
+
+
+def daily_tips_enabled():
+    return os.getenv("WHATSAPP_DAILY_TIPS_ENABLED", "false").lower() == "true"
+
+
+def daily_tip_type(day):
+    return DAILY_TIP_PREFIX + day.isoformat()
+
+
+def prepare_daily_tips():
+    day = normalize_target_date(None)
+    report = dict(status="disabled", target_date=day.isoformat(), prepared=0, duplicate=0)
+    if not daily_tips_enabled():
+        return report
+    if get_active_ramadan_period(day) is not None:
+        report["status"] = "ramadan_active"
+        return report
+
+    kind = daily_tip_type(day)
+    users = db.session.scalars(
+        db.select(User)
+        .where(User.is_active_account.is_(True), User.whatsapp_consent.is_(True),
+               User.phone_number_encrypted.isnot(None))
+        .order_by(User.id)
+        .with_for_update()
+    ).all()
+    existing = set(db.session.scalars(
+        db.select(Notification.user_id).where(Notification.notification_type == kind)
+    ))
+    for user in users:
+        if user.id in existing:
+            report["duplicate"] += 1
+            continue
+        db.session.add(Notification(user_id=user.id, notification_type=kind,
+                                    message_text=TIPS[day.toordinal() % len(TIPS)],
+                                    delivery_status="pending"))
+        report["prepared"] += 1
+    db.session.commit()
+    report["status"] = "completed"
+    return report
